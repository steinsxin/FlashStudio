{
  "name": "flashstudio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:version": "node --test packaging/common/version.test.mjs",
    "version:sync": "node packaging/common/version.mjs",
    "engine:prepare": "node scripts/prepare-openocd.mjs",
    "package:linux": "node packaging/linux/build.mjs",
    "package:arch": "node packaging/linux/arch/build.mjs",
    "package:ubuntu": "node packaging/linux/ubuntu/build.mjs",
    "package:deb": "npm run package:ubuntu",
    "package:windows": "node packaging/windows/build.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2"
  }
}
