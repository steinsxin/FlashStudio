{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlashStudio",
  "version": "1.0.0",
  "identifier": "com.steinsxin.flashstudio",
  "build": {
    "beforeDevCommand": "npm run engine:prepare && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run engine:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlashStudio",
        "width": 1000,
        "height": 760,
        "minWidth": 800,
        "minHeight": 650,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "category": "DeveloperTool",
    "shortDescription": "STM32 firmware programming with bundled OpenOCD",
    "resources": {
      "resources/openocd/": "openocd/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
